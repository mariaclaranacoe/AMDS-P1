#!/usr/bin/env python3
import h5py
from tensorflow.keras.models import load_model

MODEL_PATH = "./models/cnn_model_min_val_round10.h5"

print("=" * 60)
print("INSPECTING MODEL")
print("=" * 60)

# Load with Keras
try:
    model = load_model(MODEL_PATH, compile=False)
    print("Model loaded successfully.\n")

    print("--- Model Summary ---")
    model.summary()

    print("\n--- Basic Info ---")
    print("Input shape :", model.input_shape)
    print("Output shape:", model.output_shape)
    print("Number of layers:", len(model.layers))

    output_layer = model.layers[-1]
    print("\n--- Output Layer ---")
    print("Layer name:", output_layer.name)
    print("Layer type:", type(output_layer).__name__)

    if hasattr(output_layer, "units"):
        print("Number of output units:", output_layer.units)

    print("\n--- Model Config Keys ---")
    print(model.get_config().keys())

except Exception as e:
    print(f"Error loading model with Keras: {e}")

print("\n" + "=" * 60)
print("H5 FILE INSPECTION")
print("=" * 60)

try:
    with h5py.File(MODEL_PATH, "r") as f:
        print("\n--- Root Keys ---")
        for key in f.keys():
            print(key)

        print("\n--- Root Attributes ---")
        for key, value in f.attrs.items():
            try:
                preview = value[:200] if isinstance(value, (bytes, str)) else str(value)[:200]
                print(f"{key}: {preview}")
            except Exception:
                print(f"{key}: <unprintable>")

except Exception as e:
    print(f"Error inspecting H5 file: {e}")
