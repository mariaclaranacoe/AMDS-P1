#!/usr/bin/env python3
"""
Map class numbers to actual species and sex based on filenames
using MosquitoSong+-style preprocessing:
- mono audio
- resample to 8 kHz
- 300 ms windows
- 150 ms overlap
- average probabilities across windows
"""

import os
import glob
import numpy as np
from tensorflow.keras.models import load_model
import librosa
import warnings
warnings.filterwarnings('ignore')

# Configuration
MODEL_DIR = "./models/"
AUDIO_DIR = "./data/processec_recs_backup/"
MODEL_NAME = "cnn_model_min_val_round10.h5"

TARGET_SR = 8000
WINDOW_MS = 300
HOP_MS = 150

WINDOW_SAMPLES = int(TARGET_SR * WINDOW_MS / 1000)   # 2400
HOP_SAMPLES = int(TARGET_SR * HOP_MS / 1000)         # 1200


def extract_info_from_filename(filename):
    """Extract species and sex from filename."""
    basename = os.path.basename(filename)

    # Species
    if 'An.Dirus' in basename:
        species = 'An. dirus'
    elif 'Ae.Albopictus' in basename:
        species = 'Ae. albopictus'
    elif 'Cx.Quin' in basename:
        species = 'Cx. quinquefasciatus'
    elif 'Ae.Aegypti' in basename:
        species = 'Ae. aegypti'
    else:
        species = None

    # Sex
    sex = None
    if '_1M_' in basename:
        sex = 'MALE'
    elif '_1F_' in basename:
        sex = 'FEMALE'
    elif '_M_' in basename:
        sex = 'MALE'
    elif '_F_' in basename:
        sex = 'FEMALE'

    return species, sex


def preprocess_audio_windows(audio_path):
    """Load full audio, normalize, split into overlapping windows."""
    try:
        y, sr = librosa.load(audio_path, sr=TARGET_SR, mono=True)
        y = np.nan_to_num(y, nan=0.0, posinf=0.0, neginf=0.0).astype(np.float32)

        max_val = np.max(np.abs(y))
        if max_val > 0:
            y = y / max_val

        if len(y) < WINDOW_SAMPLES:
            y = np.pad(y, (0, WINDOW_SAMPLES - len(y)), mode='constant')

        windows = []
        for start in range(0, len(y) - WINDOW_SAMPLES + 1, HOP_SAMPLES):
            segment = y[start:start + WINDOW_SAMPLES]
            segment = segment.reshape(-1, 1).astype(np.float32)
            windows.append(segment)

        if not windows:
            return None

        return np.array(windows, dtype=np.float32)

    except Exception as e:
        print(f"Error loading {audio_path}: {e}")
        return None


def predict_class(audio_path, model):
    """Predict class by averaging probabilities across all windows."""
    windows = preprocess_audio_windows(audio_path)
    if windows is None:
        return None, None, 0

    predictions = model.predict(windows, verbose=0)
    avg_pred = np.mean(predictions, axis=0)

    class_num = int(np.argmax(avg_pred))
    confidence = float(np.max(avg_pred))
    window_count = len(windows)

    return class_num, confidence, window_count


def main():
    print("=" * 60)
    print("MAPPING CLASS NUMBERS TO SPECIES/SEX")
    print("=" * 60)

    # Load model
    model_path = os.path.join(MODEL_DIR, MODEL_NAME)
    print(f"Loading model: {MODEL_NAME}")
    model = load_model(model_path, compile=False)

    print(f"Model input shape: {model.input_shape}")
    print(f"Target SR: {TARGET_SR} Hz")
    print(f"Window: {WINDOW_MS} ms ({WINDOW_SAMPLES} samples)")
    print(f"Hop: {HOP_MS} ms ({HOP_SAMPLES} samples)")

    # Find audio files
    audio_files = glob.glob(os.path.join(AUDIO_DIR, "*.wav"))
    print(f"Found {len(audio_files)} audio files\n")

    # Store mappings
    class_mapping = {i: {} for i in range(8)}
    total_processed = 0
    total_parsed = 0

    for i, audio_file in enumerate(audio_files):
        species, sex = extract_info_from_filename(audio_file)

        if species is None or sex is None:
            if i < 20:
                print(f"⚠ Couldn't parse: {os.path.basename(audio_file)}")
            continue

        total_parsed += 1

        class_num, confidence, window_count = predict_class(audio_file, model)
        if class_num is None:
            continue

        key = f"{species}_{sex}"

        if key not in class_mapping[class_num]:
            class_mapping[class_num][key] = {
                'count': 0,
                'confidence_sum': 0.0,
                'windows_sum': 0
            }

        class_mapping[class_num][key]['count'] += 1
        class_mapping[class_num][key]['confidence_sum'] += confidence
        class_mapping[class_num][key]['windows_sum'] += window_count
        total_processed += 1

        if total_processed % 50 == 0:
            print(f"Processed {total_processed} files...")

    print("\n" + "=" * 60)
    print("CLASS MAPPING RESULTS")
    print("=" * 60)
    print(f"Total files parsed: {total_parsed}")
    print(f"Total files processed: {total_processed}\n")

    dominant_gender = {}

    for class_num in range(8):
        print(f"\nClass {class_num}:")
        if class_mapping[class_num]:
            female_votes = 0
            male_votes = 0

            for key, data in sorted(class_mapping[class_num].items(), key=lambda x: x[1]['count'], reverse=True):
                avg_confidence = data['confidence_sum'] / data['count']
                avg_windows = data['windows_sum'] / data['count']
                print(
                    f"  → {key}: {data['count']:3d} files "
                    f"(avg conf: {avg_confidence:.3f}, avg windows: {avg_windows:.1f})"
                )

                if key.endswith("_FEMALE"):
                    female_votes += data['count']
                elif key.endswith("_MALE"):
                    male_votes += data['count']

            if female_votes > male_votes:
                dominant_gender[class_num] = "FEMALE"
            elif male_votes > female_votes:
                dominant_gender[class_num] = "MALE"
            else:
                dominant_gender[class_num] = "UNCERTAIN"

            print(f"  => Dominant gender for class {class_num}: {dominant_gender[class_num]}")
        else:
            print("  No samples found")
            dominant_gender[class_num] = "UNCERTAIN"

    print("\n" + "=" * 60)
    print("SUGGESTED GENDER MAPPING")
    print("=" * 60)

    female_classes = [c for c, g in dominant_gender.items() if g == "FEMALE"]
    male_classes = [c for c, g in dominant_gender.items() if g == "MALE"]
    uncertain_classes = [c for c, g in dominant_gender.items() if g == "UNCERTAIN"]

    print(f"FEMALE_CLASSES = {female_classes}")
    print(f"MALE_CLASSES   = {male_classes}")
    print(f"UNCERTAIN      = {uncertain_classes}")
    print("=" * 60)


if __name__ == "__main__":
    main()











