File file;
const char filename[] = "/recording.wav";
const int headerSize = 44;

void setup() {
  Serial.begin(115200);
  Serial.println("Starting...");
  
  // Connect to WiFi
  connectToWiFi();
  
  // Initialize SPIFFS and I2S
  SPIFFSInit();
  i2sInit();
  
  Serial.println("Ready! Send 'e' to record and upload");
  Serial.println("Send 'l' to list files in SPIFFS");
  Serial.println("Send 'd' to delete all files");
}

void loop() {
  if (Serial.available() > 0) {
    char command = Serial.read();
    
    switch(command) {
      case 'e':
      case 'E':
        Serial.println("Starting recording...");
        startRecording();
        Serial.println("Uploading to RPi...");
        uploadToServer();
        break;
        
      case 'l':
      case 'L':
        listSPIFFS();
        break;
        
      case 'd':
      case 'D':
        deleteAllFiles();
        break;
    }
  }
}

void connectToWiFi() {
  Serial.print("Connecting to WiFi");
  WiFi.begin(ssid, password);
  
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  
  Serial.println("\nWiFi connected!");
  Serial.print("IP address: ");
  Serial.println(WiFi.localIP());
}

void startRecording() {
  // Remove old file if exists
  if (SPIFFS.exists(filename)) {
    SPIFFS.remove(filename);
    Serial.println("Removed old recording");
  }
  
  // Create new file and write WAV header
  file = SPIFFS.open(filename, FILE_WRITE);
  if (!file) {
    Serial.println("Failed to open file for writing");
    return;
  }
  
  byte header[headerSize];
  wavHeader(header, FLASH_RECORD_SIZE);
  file.write(header, headerSize);
  
  // Record audio
  recordAudio();
}

void recordAudio() {
  int i2s_read_len = I2S_READ_LEN;
  int flash_wr_size = 0;
  size_t bytes_read;

  char* i2s_read_buff = (char*) calloc(i2s_read_len, sizeof(char));
  uint8_t* flash_write_buff = (uint8_t*) calloc(i2s_read_len, sizeof(char));

  if (!i2s_read_buff || !flash_write_buff) {
    Serial.println("Failed to allocate memory");
    return;
  }

  // Clear initial buffer
  i2s_read(I2S_PORT, (void*) i2s_read_buff, i2s_read_len, &bytes_read, portMAX_DELAY);
  i2s_read(I2S_PORT, (void*) i2s_read_buff, i2s_read_len, &bytes_read, portMAX_DELAY);
  
  Serial.println(" *** Recording Start *** ");
  
  while (flash_wr_size < FLASH_RECORD_SIZE) {
    i2s_read(I2S_PORT, (void*) i2s_read_buff, i2s_read_len, &bytes_read, portMAX_DELAY);
    i2s_adc_data_scale(flash_write_buff, (uint8_t*)i2s_read_buff, i2s_read_len);
    file.write((const byte*) flash_write_buff, i2s_read_len);
    flash_wr_size += i2s_read_len;
    
    // Show progress
    int progress = (flash_wr_size * 100) / FLASH_RECORD_SIZE;
    if (progress % 25 == 0) {
      Serial.printf("Recording: %d%%\n", progress);
    }
  }
  
  file.close();
  Serial.println("Recording finished!");

  free(i2s_read_buff);
  free(flash_write_buff);
}

void uploadToServer() {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi not connected!");
    return;
  }
  
  if (!SPIFFS.exists(filename)) {
    Serial.println("Recording file not found!");
    return;
  }
  
  File file = SPIFFS.open(filename, FILE_READ);
  if (!file) {
    Serial.println("Failed to open file for reading");
    return;
  }
  
  Serial.println("Uploading to server...");
  
  HTTPClient http;
  http.begin(serverName);
  http.addHeader("Content-Type", "audio/wav");
  
  // Get file size and read into buffer
  int fileSize = file.size();
  uint8_t* fileBuffer = (uint8_t*) malloc(fileSize);
  
  if (!fileBuffer) {
    Serial.println("Failed to allocate buffer");
    file.close();
    return;
  }
  
  file.read(fileBuffer, fileSize);
  file.close();
  
  // Send the file
  int httpResponseCode = http.POST(fileBuffer, fileSize);
  
  if (httpResponseCode > 0) {
    Serial.printf("Upload successful! Response code: %d\n", httpResponseCode);
    String response = http.getString();
    Serial.println("Server response: " + response);
  } else {
    Serial.printf("Upload failed! Error: %d\n", httpResponseCode);
    Serial.printf("HTTP error: %s\n", http.errorToString(httpResponseCode).c_str());
  }
  
  http.end();
  free(fileBuffer);
  
  // Optional: Remove file after successful upload
  // if (httpResponseCode == 200) {
  //   SPIFFS.remove(filename);
  //   Serial.println("Removed local file");
  // }
}

void deleteAllFiles() {
