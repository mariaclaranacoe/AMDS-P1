// I2S Pins
#define I2S_WS 16
#define I2S_SD 17
#define I2S_SCK 18
#define I2S_PORT I2S_NUM_0
#define I2S_SAMPLE_RATE   (16000)
#define I2S_SAMPLE_BITS   (16)
#define I2S_READ_LEN      (16 * 1024)
#define RECORD_TIME       (10) // Changed to 3 seconds for mosquito recording
