const items = $input.all();

// Default result
let result = {
  totalMosquitos: 0,
  femaleCount: 0,
  femalePercentage: 0,
  maleCount: 0,
  malePercentage: 0,
  unknownCount: 0,
  errorCount: 0,
  avgConfidence: 0,
  device: 'ESP32 Trap 1',
  location: 'Community Park',
  timestamp: new Date().toLocaleString('en-US', { timeZone: 'Asia/Manila' })
};

// Look through all merged items and detect which response is which
for (const item of items) {
  const data = item.json;

  if (!data?.results?.[0]?.series?.[0]) continue;

  const series = data.results[0].series[0];
  const columns = series.columns || [];
  const values = series.values?.[0] || [];

  // Gender stats response
  if (columns.includes('female_total') || columns.includes('male_total')) {
    result.femaleCount = parseInt(values[columns.indexOf('female_total')]) || 0;
    result.maleCount = parseInt(values[columns.indexOf('male_total')]) || 0;
    result.unknownCount = parseInt(values[columns.indexOf('unknown_total')]) || 0;
    result.errorCount = parseInt(values[columns.indexOf('error_total')]) || 0;
  }

  // Total count response
  if (columns.includes('total_count')) {
    result.totalMosquitos = parseInt(values[columns.indexOf('total_count')]) || 0;
  }

  // Confidence response
  if (columns.includes('avg_confidence')) {
    const conf = parseFloat(values[columns.indexOf('avg_confidence')]);
    result.avgConfidence = isNaN(conf) ? 0 : Number((conf * 100).toFixed(1));
  }
}

// Calculate percentages
if (result.totalMosquitos > 0) {
  result.femalePercentage = Number(((result.femaleCount / result.totalMosquitos) * 100).toFixed(1));
  result.malePercentage = Number(((result.maleCount / result.totalMosquitos) * 100).toFixed(1));
} else {
  const classifiedTotal = result.femaleCount + result.maleCount + result.unknownCount;
  if (classifiedTotal > 0) {
    result.totalMosquitos = classifiedTotal;
    result.femalePercentage = Number(((result.femaleCount / classifiedTotal) * 100).toFixed(1));
    result.malePercentage = Number(((result.maleCount / classifiedTotal) * 100).toFixed(1));
  }
}

return [{ json: result }];
