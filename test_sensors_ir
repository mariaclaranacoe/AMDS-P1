// Simple Break Beam Sensor Monitor
// 6 pairs of IR LED and Photodiode connected to pins 36, 39, 34, 35, 32, 33

const int NUM_SENSORS = 6;
const int sensorPins[NUM_SENSORS] = {36, 39, 34, 35, 32, 33};
int baseline[NUM_SENSORS] = {0};
bool sensorState[NUM_SENSORS] = {false};  // Track if currently detecting
int detectionCount = 0;

// Detection settings - ADJUST THESE FOR SENSITIVITY
const float REDUCTION_PERCENT = 1.5;  // % reduction to trigger detection
const int DETECTION_DEBOUNCE_MS = 50;  // Debounce time between detections

// Timing variables
unsigned long lastSampleTime = 0;
unsigned long lastDetectionTime[NUM_SENSORS] = {0};
unsigned long lastStablePrintTime = 0;
const int SAMPLE_INTERVAL = 20;  // 20ms = 50Hz sampling
const int STABLE_PRINT_INTERVAL = 2000;  // Print stable values every 2 seconds

void calibrateSensors() {
  Serial.println("\n=== CALIBRATING SENSORS ===");
  Serial.println("Make sure ALL beams are CLEAR (nothing blocking)...");
  delay(2000);
  
  for (int i = 0; i < NUM_SENSORS; i++) {
    int sum = 0;
    Serial.print("Calibrating Sensor ");
    Serial.print(i+1);
    Serial.print(" (PIN ");
    Serial.print(sensorPins[i]);
    Serial.print(")... ");
    
    for (int j = 0; j < 50; j++) {
      sum += analogRead(sensorPins[i]);
      delay(20);
    }
    
    baseline[i] = sum / 50;
    Serial.print("Baseline: ");
    Serial.println(baseline[i]);
  }
  
  Serial.println("=== CALIBRATION COMPLETE ===");
  Serial.println();
}

void setup() {
  Serial.begin(115200);
  delay(1000);
  
  Serial.println("\n=== BREAK BEAM SENSOR MONITOR ===");
  Serial.println("6 Sensors connected to pins: 36, 39, 34, 35, 32, 33");
  Serial.print("Detection threshold: ");
  Serial.print(REDUCTION_PERCENT);
  Serial.println("% light reduction");
  Serial.println("======================================");
  
  // Configure ADC
  analogReadResolution(12);  // 12-bit resolution (0-4095)
  analogSetAttenuation(ADC_11db);  // 0-3.3V range
  
  // Initialize pins
  for (int i = 0; i < NUM_SENSORS; i++) {
    pinMode(sensorPins[i], INPUT);
    sensorState[i] = false;
    lastDetectionTime[i] = 0;
  }
  
  // Calibrate sensors
  calibrateSensors();
  
  Serial.println("Monitoring started...");
  Serial.println("Format: S1:value S2:value ... | D# = DETECTED | Count: X");
  Serial.println("Type 'c' to recalibrate, 'r' to reset count");
  Serial.println();
}

void loop() {
  unsigned long currentTime = millis();
  bool anyDetection = false;
  
  // Sample sensors at regular interval
  if (currentTime - lastSampleTime >= SAMPLE_INTERVAL) {
    
    // Read all sensors and check for detections
    for (int i = 0; i < NUM_SENSORS; i++) {
      int currentValue = analogRead(sensorPins[i]);
      int threshold = baseline[i] * (100.0 - REDUCTION_PERCENT) / 100.0;
      
      // Check for detection (beam broken)
      if (currentValue < threshold) {
        if (!sensorState[i]) {
          // New detection
          sensorState[i] = true;
          
          // Debounce check
          if (currentTime - lastDetectionTime[i] > DETECTION_DEBOUNCE_MS) {
            detectionCount++;
            anyDetection = true;
            lastDetectionTime[i] = currentTime;
            
            // Print detection immediately
            Serial.print(">>> DETECTED! Sensor ");
            Serial.print(i+1);
            Serial.print(" | Value: ");
            Serial.print(currentValue);
            Serial.print(" (Threshold: ");
            Serial.print(threshold);
            Serial.print(") | Time: ");
            Serial.print(currentTime);
            Serial.print("ms | Total Count: ");
            Serial.println(detectionCount);
          }
        }
      } else {
        sensorState[i] = false;
      }
      
      // Slow baseline adjustment (only when stable)
      if (abs(currentValue - baseline[i]) < 30) {
        baseline[i] = (baseline[i] * 0.998) + (currentValue * 0.002);
      }
    }
    
    lastSampleTime = currentTime;
  }
  
  // Print stable readings periodically (every 2 seconds)
  if (currentTime - lastStablePrintTime >= STABLE_PRINT_INTERVAL && !anyDetection) {
    Serial.print("[Stable] ");
    Serial.print("Time: ");
    Serial.print(currentTime);
    Serial.print("ms | ");
    
    // Print all sensor values
    for (int i = 0; i < NUM_SENSORS; i++) {
      int val = analogRead(sensorPins[i]);
      int threshold = baseline[i] * (100.0 - REDUCTION_PERCENT) / 100.0;
      float reduction = 100.0 * (baseline[i] - val) / baseline[i];
      
      Serial.print("S");
      Serial.print(i+1);
      Serial.print(":");
      Serial.print(val);
      
      // Add visual indicator
      if (val < threshold) {
        Serial.print("↓");  // Below threshold
      } else if (reduction > 0.5) {
        Serial.print("↘");  // Slightly reduced
      } else {
        Serial.print("✓");  // Normal
      }
      
      if (i < NUM_SENSORS - 1) Serial.print(" ");
    }
    
    Serial.print(" | Count: ");
    Serial.println(detectionCount);
    
    lastStablePrintTime = currentTime;
  }
  
  // Handle serial commands
  if (Serial.available()) {
    char command = Serial.read();
    
    if (command == 'c' || command == 'C') {
      calibrateSensors();
    }
    else if (command == 'r' || command == 'R') {
      detectionCount = 0;
      Serial.println("Detection count reset to 0");
    }
    else if (command == 's' || command == 'S') {
      // Show detailed status
      Serial.println("\n=== DETAILED SENSOR STATUS ===");
      for (int i = 0; i < NUM_SENSORS; i++) {
        int val = analogRead(sensorPins[i]);
        float reduction = 100.0 * (baseline[i] - val) / baseline[i];
        int threshold = baseline[i] * (100.0 - REDUCTION_PERCENT) / 100.0;
        
        Serial.print("Sensor ");
        Serial.print(i+1);
        Serial.print(" (PIN ");
        Serial.print(sensorPins[i]);
        Serial.print("): Value=");
        Serial.print(val);
        Serial.print(" Baseline=");
        Serial.print(baseline[i]);
        Serial.print(" Threshold=");
        Serial.print(threshold);
        Serial.print(" Reduction=");
        Serial.print(reduction, 1);
        Serial.print("% Status=");
        Serial.println(sensorState[i] ? "BLOCKED" : "CLEAR");
      }
      Serial.println("==============================");
    }
  }
  
  delay(1);  // Small delay to prevent watchdog issues
}
